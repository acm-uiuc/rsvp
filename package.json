{
  "name": "rsvp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env VITE_RUN_ENVIRONMENT=local-dev vite",
    "dev:qa": "cross-env VITE_RUN_ENVIRONMENT=dev vite",
    "build": "tsc && vite build",
    "build:dev": "cross-env VITE_RUN_ENVIRONMENT=dev tsc && vite build",
    "build:prod": "cross-env VITE_RUN_ENVIRONMENT=prod tsc && vite build",
    "preview": "cross-env VITE_RUN_ENVIRONMENT=local-dev vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "test": "npm run typecheck && npm run lint"
  },
  "dependencies": {
    "@acm-uiuc/core-client": "^4.11.0",
    "@acm-uiuc/js-shared": "^3.8.3",
    "@azure/msal-browser": "^5.19.0",
    "@azure/msal-react": "^5.6.0",
    "@mantine/core": "^9.5.2",
    "@mantine/hooks": "^9.5.2",
    "@mantine/notifications": "^9.5.2",
    "@marsidev/react-turnstile": "^1.6.0",
    "@tabler/icons-react": "^3.46.0",
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-qr-code": "^2.2.0",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2"
  }
}
